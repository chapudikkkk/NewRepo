<Window x:Class="lab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab5"
        mc:Ignorable="d"
        Title="Каталог студентів" Height="560" Width="850"
        MinHeight="500" MinWidth="800"
        Background="#F4F4F4">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Додати студента" Grid.Row="0" Padding="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ПІБ:" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                <TextBox x:Name="FullNameTextBox" Grid.Row="0" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Рік народження:" Grid.Row="0" Grid.Column="2" Margin="5" VerticalAlignment="Center"/>
                <TextBox x:Name="YearTextBox" Grid.Row="0" Grid.Column="3" Margin="5"/>

                <TextBlock Text="Школа №:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                <TextBox x:Name="SchoolTextBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

                <TextBlock Text="ID:" Grid.Row="1" Grid.Column="2" Margin="5" VerticalAlignment="Center"/>
                <TextBox x:Name="IdTextBox" Grid.Row="1" Grid.Column="3" Margin="5"/>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="StudentsDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,5" GridLinesVisibility="All" HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ПІБ студента" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Рік народження" Binding="{Binding BirthYear}" Width="1*"/>
                <DataGridTextColumn Header="Школа" Binding="{Binding School}" Width="1*"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5" Background="#FFD700" Width="780">
            <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="SearchTextBox" Width="151" Margin="3" Padding="3"/>
            <Button Content="Знайти" Margin="3" Click="SearchButton_Click" Width="77"/>
            <Button Content="Unique Школи" Margin="3" Click="UniqueSchoolsButton_Click" Width="95"/>
            <Button Content="3 найстарші" Margin="3" Click="OldestStudentsButton_Click" Width="91"/>
            <Button Content="Середній рік" Margin="3" Click="AverageYearButton_Click" Width="87"/>
            <Button Content="Найдовше ПІБ" Margin="3" Click="GroupStudentsButton_Click" Width="87"/>
            <Button Content="Усі студенти" Margin="3" Click="ResetButton_Click" Width="98"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="Додати" Click="AddButton_Click" Width="80" Margin="5"/>
            <Button Content="Видалити" Click="DeleteButton_Click" Width="80" Margin="5"/>
            <Button Content="Сортувати" Click="SortButton_Click" Width="80" Margin="5"/>
            <Button Content="Фільтр" Click="FilterButton_Click" Width="80" Margin="5"/>
            <Button Content="Зберегти" Click="SaveButton_Click" Width="80" Margin="5"/>
            <Button Content="Завантажити" Click="LoadButton_Click" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>