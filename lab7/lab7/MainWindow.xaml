<Window x:Class="lab7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фондова біржа" Height="450" Width="650" WindowStartupLocation="CenterScreen"
        Background="#14263D" Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Фондова біржf" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>        <GroupBox Grid.Row="1" Header="Панель керування" Padding="10" Margin="0,0,0,15" Foreground="White" BorderThickness="0" Background="#203A59" FontSize="15">
            <StackPanel>
                <TextBlock Text="Нова ціна нафти:" Margin="0,0,0,5" Foreground="White"/>
                <TextBox x:Name="txtPrice" Text="82" Height="30" Margin="0,0,0,10" Background="#E8EEF5" Foreground="#14263D" BorderThickness="0" FontSize="15" Padding="5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Змінити ціну" Width="130" Height="32" Margin="5" Click="btnChangePrice_Click" Background="#347DB5" Foreground="White" BorderThickness="0"/>
                    <Button Content="Закрити ринок" Width="130" Height="32" Margin="5" Click="btnCloseMarket_Click" Background="#347DB5" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Журнал подій" Padding="10" Foreground="White" BorderThickness="0" Background="#203A59" FontSize="15">
            <ListBox x:Name="logListBox" FontSize="14" Background="#14263D" Foreground="White" BorderThickness="0" Padding="5"/>
        </GroupBox>
    </Grid>
</Window>